<mxfile>
  <diagram id="uc-ca" name="UC Ca làm việc &amp; Hoàn trả">
    <mxGraphModel dx="1200" dy="650" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="500" math="0" shadow="0">
