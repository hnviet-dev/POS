<mxfile>
  <diagram id="uc-xacthuc" name="UC Xác thực">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="sb" value="&lt;b&gt;XÁC THỰC HỆ THỐNG&lt;/b&gt;" style="shape=mxgraph.sysml.package;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=5;fontSize=13;fillColor=none;strokeColor=#000;" vertex="1" parent="1">
          <mxGeometry x="180" y="20" width="450" height="500" as="geometry"/>
        </mxCell>
        <mxCell id="a1" value="Người dùng" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=11;strokeColor=#000;" vertex="1" parent="1">
          <mxGeometry x="60" y="180" width="30" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="a2" value="Gmail SMTP" style="shape=rect;whiteSpace=wrap;html=1;fontSize=10;fillColor=none;strokeColor=#000;" vertex="1" parent="1">
          <mxGeometry x="700" y="300" width="100" height="35" as="geometry"/>
        </mxCell>
        <!-- UC chính -->
        <mxCell id="uc0" value="Xác thực hệ thống&#xa;(from Model)" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=none;strokeColor=#000;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="200" width="180" height="50" as="geometry"/>
        </mxCell>
        <!-- Extend UCs -->
        <mxCell id="uc1" value="Đăng nhập" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=none;strokeColor=#000;" vertex="1" parent="1">
          <mxGeometry x="220" y="50" width="160" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="uc2" value="Đăng ký tài khoản" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=none;strokeColor=#000;" vertex="1" parent="1">
          <mxGeometry x="440" y="50" width="160" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="uc3" value="Quên mật khẩu" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=none;strokeColor=#000;" vertex="1" parent="1">
          <mxGeometry x="440" y="300" width="160" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="uc4" value="Đặt lại mật khẩu" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=none;strokeColor=#000;" vertex="1" parent="1">
          <mxGeometry x="440" y="380" width="160" height="38" as="geometry"/>
        </mxCell>
        <!-- Include UCs -->
        <mxCell id="uc5" value="Xác thực JWT" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=none;strokeColor=#000;" vertex="1" parent="1">
          <mxGeometry x="220" y="350" width="160" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="uc6" value="Gửi email đặt lại MK" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=none;strokeColor=#000;" vertex="1" parent="1">
          <mxGeometry x="440" y="450" width="160" height="38" as="geometry"/>
        </mxCell>
        <!-- Actor connections -->
        <mxCell id="e1" style="endArrow=none;strokeColor=#000;" edge="1" source="a1" target="uc0" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="endArrow=none;strokeColor=#000;" edge="1" source="a1" target="uc1" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="endArrow=none;strokeColor=#000;" edge="1" source="a2" target="uc6" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- <<extend>> -->
        <mxCell id="ex1" style="endArrow=open;endSize=10;dashed=1;strokeColor=#000;" edge="1" source="uc1" target="uc0" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ex1l" value="&lt;i&gt;&amp;lt;&amp;lt;extend&amp;gt;&amp;gt;&lt;/i&gt;" style="edgeLabel;html=1;fontSize=9;" vertex="1" connectable="0" parent="ex1"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="ex2" style="endArrow=open;endSize=10;dashed=1;strokeColor=#000;" edge="1" source="uc2" target="uc0" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ex2l" value="&lt;i&gt;&amp;lt;&amp;lt;extend&amp;gt;&amp;gt;&lt;/i&gt;" style="edgeLabel;html=1;fontSize=9;" vertex="1" connectable="0" parent="ex2"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="ex3" style="endArrow=open;endSize=10;dashed=1;strokeColor=#000;" edge="1" source="uc3" target="uc0" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ex3l" value="&lt;i&gt;&amp;lt;&amp;lt;extend&amp;gt;&amp;gt;&lt;/i&gt;" style="edgeLabel;html=1;fontSize=9;" vertex="1" connectable="0" parent="ex3"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="ex4" style="endArrow=open;endSize=10;dashed=1;strokeColor=#000;" edge="1" source="uc4" target="uc3" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ex4l" value="&lt;i&gt;&amp;lt;&amp;lt;extend&amp;gt;&amp;gt;&lt;/i&gt;" style="edgeLabel;html=1;fontSize=9;" vertex="1" connectable="0" parent="ex4"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <!-- <<include>> -->
        <mxCell id="in1" style="endArrow=open;endSize=10;dashed=1;strokeColor=#000;" edge="1" source="uc0" target="uc5" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="in1l" value="&lt;i&gt;&amp;lt;&amp;lt;include&amp;gt;&amp;gt;&lt;/i&gt;" style="edgeLabel;html=1;fontSize=9;" vertex="1" connectable="0" parent="in1"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="in2" style="endArrow=open;endSize=10;dashed=1;strokeColor=#000;" edge="1" source="uc3" target="uc6" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="in2l" value="&lt;i&gt;&amp;lt;&amp;lt;include&amp;gt;&amp;gt;&lt;/i&gt;" style="edgeLabel;html=1;fontSize=9;" vertex="1" connectable="0" parent="in2"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
