<mxCell id="L0" value="Store Admin" style="swimlane;startSize=30;html=0;fillColor=#ffffff;strokeColor=#000000;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="280" height="1100" as="geometry"/></mxCell>
<mxCell id="L1" value="Hệ thống" style="swimlane;startSize=30;html=0;fillColor=#ffffff;strokeColor=#000000;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="50" width="350" height="1100" as="geometry"/></mxCell>
