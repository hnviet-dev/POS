<mxCell id="a9" value="Chọn Store cần duyệt" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="L2"><mxGeometry x="30" y="660" width="200" height="40" as="geometry"/></mxCell>
<mxCell id="d1" value="Quyết định
