<mxCell id="a2" value="Nhập thông tin cửa hàng:
brand, description,
storeType, contact" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="L0"><mxGeometry x="30" y="180" width="230" height="60" as="geometry"/></mxCell>
<mxCell id="a3" value="POST /api/stores
Gửi dữ liệu tạo Store" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="L1"><mxGeometry x="70" y="180" width="220" height="50" as="geometry"/></mxCell>
<mxCell id="a4" value="Lấy currentUser từ JWT
Tạo Store(storeAdmin=user)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="L1"><mxGeometry x="70" y="270" width="220" height="50" as="geometry"/></mxCell>
<mxCell id="a5" value="Set status = PENDING
