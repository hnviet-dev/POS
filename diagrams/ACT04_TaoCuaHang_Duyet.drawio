<mxCell id="a6" value="Trả về Store (PENDING)
Chờ Super Admin duyệt" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="L1"><mxGeometry x="70" y="430" width="220" height="50" as="geometry"/></mxCell>
