status → ACTIVE" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="L1"><mxGeometry x="70" y="830" width="220" height="60" as="geometry"/></mxCell>
