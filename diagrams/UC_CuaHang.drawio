<mxfile>
  <diagram id="uc-cuahang" name="UC Quản lý cửa hàng">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="550" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="sb" value="&lt;b&gt;QUẢN LÝ CỬA HÀNG&lt;/b&gt;" style="shape=mxgraph.sysml.package;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=5;fontSize=13;fillColor=none;strokeColor=#000;" vertex="1" parent="1">
          <mxGeometry x="180" y="20" width="420" height="460" as="geometry"/>
        </mxCell>
        <mxCell id="a1" value="Super Admin" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=11;strokeColor=#000;" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="30" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="a2" value="Store Admin" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=11;strokeColor=#000;" vertex="1" parent="1">
          <mxGeometry x="60" y="300" width="30" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="uc0" value="Quản lý cửa hàng&#xa;(from Model)" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=none;strokeColor=#000;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="180" width="180" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="uc1" value="Xem DS cửa hàng" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=none;strokeColor=#000;" vertex="1" parent="1">
          <mxGeometry x="220" y="50" width="160" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="uc2" value="Duyệt cửa hàng" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=none;strokeColor=#000;" vertex="1" parent="1">
          <mxGeometry x="420" y="50" width="160" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="uc3" value="Chặn cửa hàng" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=none;strokeColor=#000;" vertex="1" parent="1">
          <mxGeometry x="420" y="120" width="160" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="uc4" value="Tạo cửa hàng mới" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=none;strokeColor=#000;" vertex="1" parent="1">
          <mxGeometry x="220" y="300" width="160" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="uc5" value="Cập nhật thông tin" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=none;strokeColor=#000;" vertex="1" parent="1">
          <mxGeometry x="420" y="300" width="160" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="uc6" value="Xem chi tiết cửa hàng" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=none;strokeColor=#000;" vertex="1" parent="1">
          <mxGeometry x="300" y="380" width="170" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="uc7" value="Đăng nhập" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=none;strokeColor=#000;" vertex="1" parent="1">
          <mxGeometry x="300" y="440" width="140" height="35" as="geometry"/>
        </mxCell>
        <!-- Actor connections -->
        <mxCell id="e1" style="endArrow=none;strokeColor=#000;" edge="1" source="a1" target="uc0" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="endArrow=none;strokeColor=#000;" edge="1" source="a2" target="uc0" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- <<extend>> -->
        <mxCell id="x1" style="endArrow=open;endSize=10;dashed=1;strokeColor=#000;" edge="1" source="uc1" target="uc0" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="x1l" value="&lt;i&gt;&amp;lt;&amp;lt;extend&amp;gt;&amp;gt;&lt;/i&gt;" style="edgeLabel;html=1;fontSize=9;" vertex="1" connectable="0" parent="x1"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="x2" style="endArrow=open;endSize=10;dashed=1;strokeColor=#000;" edge="1" source="uc2" target="uc0" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="x2l" value="&lt;i&gt;&amp;lt;&amp;lt;extend&amp;gt;&amp;gt;&lt;/i&gt;" style="edgeLabel;html=1;fontSize=9;" vertex="1" connectable="0" parent="x2"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="x3" style="endArrow=open;endSize=10;dashed=1;strokeColor=#000;" edge="1" source="uc3" target="uc0" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="x3l" value="&lt;i&gt;&amp;lt;&amp;lt;extend&amp;gt;&amp;gt;&lt;/i&gt;" style="edgeLabel;html=1;fontSize=9;" vertex="1" connectable="0" parent="x3"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="x4" style="endArrow=open;endSize=10;dashed=1;strokeColor=#000;" edge="1" source="uc4" target="uc0" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="x4l" value="&lt;i&gt;&amp;lt;&amp;lt;extend&amp;gt;&amp;gt;&lt;/i&gt;" style="edgeLabel;html=1;fontSize=9;" vertex="1" connectable="0" parent="x4"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="x5" style="endArrow=open;endSize=10;dashed=1;strokeColor=#000;" edge="1" source="uc5" target="uc0" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="x5l" value="&lt;i&gt;&amp;lt;&amp;lt;extend&amp;gt;&amp;gt;&lt;/i&gt;" style="edgeLabel;html=1;fontSize=9;" vertex="1" connectable="0" parent="x5"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="x6" style="endArrow=open;endSize=10;dashed=1;strokeColor=#000;" edge="1" source="uc6" target="uc0" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="x6l" value="&lt;i&gt;&amp;lt;&amp;lt;extend&amp;gt;&amp;gt;&lt;/i&gt;" style="edgeLabel;html=1;fontSize=9;" vertex="1" connectable="0" parent="x6"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <!-- <<include>> -->
        <mxCell id="i1" style="endArrow=open;endSize=10;dashed=1;strokeColor=#000;" edge="1" source="uc0" target="uc7" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i1l" value="&lt;i&gt;&amp;lt;&amp;lt;include&amp;gt;&amp;gt;&lt;/i&gt;" style="edgeLabel;html=1;fontSize=9;" vertex="1" connectable="0" parent="i1"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
