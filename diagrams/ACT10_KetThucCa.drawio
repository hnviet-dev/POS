<mxCell id="a5" value="Tính toán:
totalSales = SUM(orders)
totalRefunds = SUM(refunds)
netSales = totalSales - totalRefunds
totalOrders = COUNT(orders)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="L1"><mxGeometry x="80" y="350" width="240" height="90" as="geometry"/></mxCell>
